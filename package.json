{
  "name": "midi-stepper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local 1-8 track, up to 64 step MIDI stepper with lookahead scheduling.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tsconfig/svelte": "^5.0.4",
    "jsdom": "^24.1.3",
    "svelte": "^4.2.19",
    "svelte-check": "^3.8.6",
    "tslib": "^2.8.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
